{
    "name": "nevela/laravel",
    "description": "Nevela: Laravel as the authority behind Flare's Next.js frontend. Resource-driven generation and a Flare-compatible REST contract.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.17|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "Nevela\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Nevela\\Laravel\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Nevela\\Laravel\\NevelaServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}
